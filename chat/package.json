{
  "name": "sockress-chat",
  "version": "0.2.8",
  "description": "Chat and room management for Sockress - Create rooms, join/leave, and send messages seamlessly.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "author": {
    "name": "Also Coder",
    "email": "hello@alsocoder.com",
    "url": "https://alsocoder.com"
  },
  "homepage": "https://alsocoder.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/alsocoders/sockress"
  },
  "bugs": {
    "url": "https://github.com/alsocoders/sockress/issues"
  },
  "license": "PROPRIETARY",
  "keywords": [
    "sockress",
    "chat",
    "rooms",
    "websocket",
    "realtime",
    "messaging"
  ],
  "dependencies": {
    "nanoid": "^5.1.6"
  },
  "peerDependencies": {
    "sockress": "^0.4.2",
    "sockress-client": "^0.2.8"
  },
  "peerDependenciesMeta": {
    "sockress": {
      "optional": true
    },
    "sockress-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "sockress": "^0.4.2",
    "sockress-client": "^0.2.8"
  }
}